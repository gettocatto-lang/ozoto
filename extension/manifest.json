{
  "manifest_version": 3,
  "name": "Öz Oto Radar",
  "short_name": "Radar",
  "version": "1.2.0",
  "description": "Açtığınız ilan sayfalarındaki araçları Öz Oto Kelepir Radar'a gönderir, kelepir puanını gösterir ve sayfadaki kelepirleri bir panelde toplar.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Öz Oto Radar" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.sahibinden.com/*",
    "https://*.arabam.com/*",
    "https://*.letgo.com/*",
    "https://*.facebook.com/*",
    "https://ozoto.online/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.sahibinden.com/*",
        "https://*.arabam.com/*",
        "https://*.letgo.com/*",
        "https://*.facebook.com/marketplace/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

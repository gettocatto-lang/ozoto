<?xml version="1.0" encoding="UTF-8"?>
<!--
  Güvenlik ağı: Plesk'te Document root yanlışlıkla "site" (public olmadan) seçilirse
  kaynak kod, ayarlar ve yüklenen fotoğraflar web'den açılmasın.
  Doğru ayar "site\public"tir; o durumda IIS bu dosyayı hiç okumaz.
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="config" />
          <add segment="database" />
          <add segment="docs" />
          <add segment="src" />
          <add segment="storage" />
          <add segment="templates" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
